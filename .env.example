# Copy to .env (ingestion + local API) and fill in.

# Neon Postgres connection string (with ?sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# NASA FIRMS map key — get a free one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# FIRMS noise controls (optional — sensible defaults in config.py). FIRMS is
# aggregated to one event per (country, day):
#   FIRMS_GRID_DEG       internal geocoding-grid size in degrees; rarely changed (default 1.0)
#   FIRMS_MIN_DETECTIONS min detections for a country-day to show; higher = fewer dots (default 200)
#   FIRMS_MIN_INTENSITY  drop country-days below this 0..1 intensity (default 0.3333 = minor)
# FIRMS_GRID_DEG=1.0
# FIRMS_MIN_DETECTIONS=200
# FIRMS_MIN_INTENSITY=0.3333

# --- Spike sources (opt-in; each source skips cleanly when its key is unset)

# OpenAQ — free key at https://openaq.org (used by air_quality source)
# OPENAQ_API_KEY=your_openaq_key_here

# Global Forest Watch Data API — anonymous calls work but are rate-limited.
# Get a free key at https://www.globalforestwatch.org/developers/
# GFW_API_KEY=your_gfw_key_here

# Copernicus Marine Service — register at https://data.marine.copernicus.eu/register
# CMEMS_USERNAME=
# CMEMS_PASSWORD=

# Frontend: URL of the deployed FastAPI service (no trailing slash).
# For local dev this is http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
